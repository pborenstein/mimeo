# Mimeo configuration example.
# Copy to ~/.config/mimeo/config.toml, fill in credentials, chmod 600.
# Any setting can be overridden with a MIMEO_* env var (e.g.
# MIMEO_PORKBUN_API_KEY); env vars win over this file.

schema_version = 1

[porkbun]
# API key from https://porkbun.com/account/api
api_key = "pk1_your_api_key"
secret_key = "sk1_your_secret_key"
# default_ttl = 600

[github]
# Where new site repositories are created (user or org)
default_org = "your-username-or-org"
# Where template repositories live; need not match default_org (default: tepiton)
# template_org = "tepiton"
# Authentication is via the gh CLI ('gh auth login'), not this file.
# default_private = false

[defaults]
# Default template for new sites, looked up in github.template_org (default: mimeo)
# template = "mimeo"
# Domains excluded from fleet-wide sweeps (status --all / sync --all)
# ignore_domains = ["example.dev", "elsewhere.net"]
